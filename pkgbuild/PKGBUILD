pkgname=omascope
pkgver=0.1.1
pkgrel=1
pkgdesc='Keyboard-first process manager for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/omascope/omascope'
license=('MIT')
depends=('quickshell' 'hicolor-icon-theme' 'omarchy')
makedepends=('cargo' 'gcc' 'make')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."

  install -Dm755 build/omascope "$pkgdir/usr/bin/omascope"

  # The interface ships as data beside the binary, because Quickshell serves a
  # config directory from disk rather than from a Qt resource.
  install -d "$pkgdir/usr/share/omascope/ui/i18n"
  install -Dm644 ui/*.qml -t "$pkgdir/usr/share/omascope/ui"
  install -Dm644 ui/i18n/*.json -t "$pkgdir/usr/share/omascope/ui/i18n"

  # Quickshell resolves qs.Commons and qs.Ui inside the config root, so the
  # shared shell components are linked in rather than copied.
  ln -sfn /usr/share/omarchy/shell/Commons "$pkgdir/usr/share/omascope/ui/Commons"
  ln -sfn /usr/share/omarchy/shell/Ui "$pkgdir/usr/share/omascope/ui/Ui"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omascope.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omascope.svg"
  install -Dm644 "$startdir/omascope.desktop" "$pkgdir/usr/share/applications/omascope.desktop"
}

#!/bin/sh
# Builds the Rust backend and makes the theme and component libraries Omarchy
# ships visible to Quickshell under their qs.Commons and qs.Ui import names.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

# A rustup toolchain lives in ~/.cargo/bin, which a non-login shell (a launcher,
# a panel, a cron job) does not have on PATH.
if ! command -v cargo >/dev/null 2>&1 && [ -f "${CARGO_HOME:-$HOME/.cargo}/env" ]; then
    . "${CARGO_HOME:-$HOME/.cargo}/env"
fi
if ! command -v cargo >/dev/null 2>&1; then
    echo "omascope: cargo is not installed. Install rustup, then run this again." >&2
    exit 1
fi

OMARCHY_SHELL="${OMARCHY_PATH:-/usr/share/omarchy}/shell"
for module in Commons Ui; do
    link="$ROOT/ui/$module"
    if [ -e "$link" ] || [ -L "$link" ]; then
        continue
    fi
    if [ -d "$OMARCHY_SHELL/$module" ]; then
        ln -s "$OMARCHY_SHELL/$module" "$link"
    else
        printf 'omascope: %s is missing, so the theme will use its fallback colors\n' "$OMARCHY_SHELL/$module" >&2
    fi
done

cargo build --release --target-dir "$ROOT/build"
mkdir -p "$ROOT/build"
# Rename rather than copy in place: the window may be running from the old
# binary, and replacing the path is allowed where overwriting it is not.
cp "$ROOT/build/release/omascope" "$ROOT/build/omascope.new"
mv -f "$ROOT/build/omascope.new" "$ROOT/build/omascope"

echo "Built $ROOT/build/omascope"
